{
  "name": "@sentinel/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node --enable-source-maps --watch dist/main.js --replay tests/fixtures/account-updates.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sentinel/config": "workspace:*",
    "@sentinel/core": "workspace:*",
    "@sentinel/database": "workspace:*",
    "@sentinel/detection": "workspace:*",
    "@sentinel/solana-adapters": "workspace:*",
    "@solana/web3.js": "catalog:",
    "@triton-one/yellowstone-grpc": "catalog:",
    "bs58": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
