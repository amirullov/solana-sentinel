NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
API_HOST=127.0.0.1
API_PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4100

# Optional: required only for live ingestion. Never commit real credentials.
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_X_TOKEN=
SOLANA_RPC_URL=https://api.devnet.solana.com
# Independent public Devnet operator; rate-limited, development only.
SOLANA_SECONDARY_RPC_URL=https://solana-devnet.api.onfinality.io/public
SOLANA_CLUSTER=devnet
# Devnet registry used by the free RPC polling example; replace to watch your program.
WATCHED_PROGRAM_IDS=BZ3PWjMS6g4bkPjr66h5Vb4e2qHyj3To2EDzTT9j5yY6
WATCHED_ACCOUNT_IDS=
RPC_BACKFILL_MAX_SIGNATURES=1000
WEBHOOK_SIGNING_SECRET=

# Safety defaults: publication is disabled until explicitly enabled.
PUBLISHER_ENABLED=false
PUBLISHER_CONFIRM_PROGRAM_DEPLOYED=false
PUBLISHER_KEYPAIR_PATH=
SENTINEL_REGISTRY_PROGRAM_ID=BZ3PWjMS6g4bkPjr66h5Vb4e2qHyj3To2EDzTT9j5yY6

